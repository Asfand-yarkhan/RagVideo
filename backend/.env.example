# Copy this file to .env and fill in your values. Never commit .env.

# Required: get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Models (defaults shown)
# WRITER_MODEL=openai/gpt-oss-120b
# FAST_MODEL=openai/gpt-oss-20b
# WHISPER_MODEL=whisper-large-v3-turbo

# Hugging Face embedding model (downloaded and run locally, no key needed)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── If YouTube blocks you ("Sign in to confirm you're not a bot") ──────────
# Local use: let yt-dlp read your YouTube login from your browser at runtime.
# Options: firefox, edge, chrome, brave. Firefox is the most reliable on Windows;
# Chromium browsers usually need to be fully closed first.
# YTDLP_COOKIES_FROM_BROWSER=firefox

# Deployed servers: use a residential proxy instead.
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# or any proxy URL:
# PROXY_URL=http://user:pass@host:port

# Transcribe videos without captions from their audio (uses Groq Whisper)
# ENABLE_WHISPER_FALLBACK=true
# WHISPER_MAX_VIDEO_MINUTES=120

# Max transcript tokens sent per request (keeps you under Groq free-tier limits)
# MAX_TRANSCRIPT_TOKENS_PER_CALL=5000

# CORS_ORIGINS=http://localhost:5173
